@namespace Portfolio.Components
@inherits LayoutComponentBase

<MudTabs @bind-ActivePanelIndex="ActivePanelIndex" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-0">
    <ChildContent>
        @foreach (var item in Tabs)
        {
            <MudTabPanel Text="@item.Name" ToolTip="@item.githuburl">
                <MudPaper Height="85vh" Width="95%">
                    <iframe class="iframe" src="@item.hostingurl"></iframe>
                </MudPaper>
            </MudTabPanel>
        }
    </ChildContent>
    <Header>
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Title="Project Github Page" Color="Color.Inherit" Link="@Tabs[ActivePanelIndex].githuburl" Target="_blank" />
    </Header>
</MudTabs>

<style>
    .container {
        position: relative;
        overflow: hidden;
        width: 95%;
        height: 88vh;
    }

    .iframe {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }
</style>

@code {
    [Parameter]
    public List<TabView> Tabs { get; set; } = new();

    private int ActivePanelIndex { get; set; } = 0;

    public class TabView
    {
        public string Name { get; set; }
        public string githuburl { get; set; }
        public string hostingurl { get; set; }
        public Guid Id { get; set; }
    }
}
