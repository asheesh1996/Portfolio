@page "/algorithm"

<PageTitle>Different Algorithms Implementation</PageTitle>
<MudTabs @bind-ActivePanelIndex="_index" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-0">
    <ChildContent>
        @foreach (var item in _tabs)
        {
            <MudTabPanel Text="@item.Name">

                <MudPaper Height="85vh" Width="95%">
               
                </MudPaper>

            </MudTabPanel>
        }
    </ChildContent>
</MudTabs>

<style>
    .container {
        position: relative;
        overflow: hidden;
        width: 95%;
        height: 88vh; /* 16:9 Aspect Ratio (divide 9 by 16 = 0.5625) */
    }

    /* Then style the iframe to fit in the container div with full height and width */
    .iframe {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }
</style>

@code
{
    private class TabView
    {
        public String Name { get; set; }
        public Guid Id { get; set; }
    }
    private List<TabView> _tabs = new();
    private int _index = 0;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        _tabs.Add(new TabView { Name = "Sorting", Id = Guid.NewGuid() });
    }

}