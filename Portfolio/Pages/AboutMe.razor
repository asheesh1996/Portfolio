<MudText Color="Color.Secondary" Align="Align.Center" Typo="Typo.h4">Professional Experience</MudText>
<MudTimeline>
    @foreach (var item in WorkExperience.Concat(OpenSourceProjects.Select(p => new WorkExperienceItem
    {
        DateRange = p.DateRange ?? "",  // Use empty string if DateRange is null
        Company = p.Name,
        Position = "Open Source Contributor",
        Description = p.Description,
        MediaLinks = new List<MediaLink>
        {
            new MediaLink { Url = p.Url, Description = "Project Media" }
        }
    })))
    {
        <MudTimelineItem Color="Color.Primary" Size="Size.Medium">
            <ItemOpposite>
                <MudText Color="Color.Dark" Typo="Typo.h6">@item.DateRange</MudText>
            </ItemOpposite>
            <ItemContent>
                <MudPaper Elevation="3" Class="pa-3">
                    <MudText Color="Color.Primary" Typo="Typo.h6" GutterBottom="true">@item.Company</MudText>
                    <MudText>@item.Position</MudText>
                    <MudDivider Class="my-2" />
                    <MudText>@item.Description</MudText>
                    @if (item.MediaLinks != null && item.MediaLinks.Any())
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle1">Projects and Media:</MudText>
                        <MudList>
                            @foreach (var link in item.MediaLinks)
                            {
                                <MudListItem>
                                    <MudHover>
                                        <MudHoverTrigger>
                                            <MudLink Href="@link.Url" Target="_blank">@link.Description</MudLink>
                                        </MudHoverTrigger>
                                        <MudHoverContent>
                                            <MudPaper Elevation="4" Class="pa-3">
                                                <MudText>@link.Description</MudText>
                                                <MudImage Src="@link.Url" Alt="@link.Description" Style="width: 100%; height: auto;" />
                                            </MudPaper>
                                        </MudHoverContent>
                                    </MudHover>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudPaper>
            </ItemContent>
        </MudTimelineItem>
    }
</MudTimeline>


