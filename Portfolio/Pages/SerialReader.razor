@page "/serialreader"

@using System;
@using System.Threading.Tasks;
@inject IJSRuntime JS

<PageTitle>Serial Reader</PageTitle>
<MudText Typo="Typo.h6" Class="mud-width-full" @onclick ="UpdatePorts">@(portName == null ? "Nothing selected." : $"COM PORT: {portName}")</MudText>
<div class="d-flex flex-grow-1 gap-4">
    <MudSelect Dense="true" T="string" Label="COM PORTS" @bind-SelectedValue="@portName" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
        @foreach (var item in portNames)
        {
            <MudSelectItem Value="@item">@item</MudSelectItem>
        }
    </MudSelect>
    <MudSelect Dense="true" T="int" Label="BaudRate" @bind-SelectedValue="@selectedBaudrate" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
        <MudSelectItem Value=@(300) />
        <MudSelectItem Value=@(600) />
        <MudSelectItem Value=@(1200) />
        <MudSelectItem Value=@(2400) />
        <MudSelectItem Value=@(4800) />
        <MudSelectItem Value=@(9600) />
        <MudSelectItem Value=@(19200) />
        <MudSelectItem Value=@(38400) />
        <MudSelectItem Value=@(57600) />
        <MudSelectItem Value=@(74800) />
        <MudSelectItem Value=@(115200) />
        <MudSelectItem Value=@(230400) />
        <MudSelectItem Value=@(230400) />
        <MudSelectItem Value=@(250000) />
        <MudSelectItem Value=@(500000) />
        <MudSelectItem Value=@(1000000) />
        <MudSelectItem Value=@(2000000) />
    </MudSelect>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="TogglePort">@portStatus</MudButton>
</div>
<MudText Align="Align.Justify">@SerialDataString</MudText>

@code {
    private string portName;
    private int selectedBaudrate = 9600;
    private List<string> portNames = new List<string>();
    private string portStatus = "Open";
    private string SerialDataString = "";

    protected override async Task OnInitializedAsync()
    {
        await UpdatePorts();
    }

    private async Task TogglePort()
    {
        SerialDataString = "";
        if (portStatus == "Open")
        {
            bool isConnected = await JS.InvokeAsync<bool>("serialHelper.connect", selectedBaudrate);
            if (isConnected)
            {
                portStatus = "Close";
                await ReadFromPort();
            }
        }
        else
        {
            await JS.InvokeVoidAsync("serialHelper.disconnect");
            portStatus = "Open";
        }
    }

    private async Task ReadFromPort()
    {
        while (portStatus == "Close")
        {
            string data = await JS.InvokeAsync<string>("serialHelper.read");
            if (!string.IsNullOrEmpty(data))
            {
                SerialDataString += data;
                StateHasChanged();
            }
            await Task.Delay(100);
        }
    }

    private async Task UpdatePorts()
    {
        portNames = await JS.InvokeAsync<List<string>>("serialHelper.getPorts");
    }
}
