@page "/games"

<PageTitle> Gaming Zone</PageTitle>
<TabViewComponent Tabs = "_tabs" />
@code
{
      private List<TabViewComponent.TabView> _tabs = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _tabs.Add(new TabViewComponent.TabView { githuburl = "https://github.com/asheesh1996/sudokuapp", Name = "Sudoku Game", Id = Guid.NewGuid(), hostingurl = "https://asheesh1996.github.io/sudokuapp/" });
    }

}