@page "/computervision"

<PageTitle> Computer Vision</PageTitle>
<TabViewComponent Tabs = "_tabs" />

@code
{
   private List<TabViewComponent.TabView> _tabs = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _tabs.Add(
            new TabViewComponent.TabView 
            { 
                Id = Guid.NewGuid(), 
                Name = "Open Cv PlayGround", 
                githuburl = "https://github.com/asheesh1996/ComputerVisionSamples", 
                hostingurl = "https://asheesh1996.github.io/ComputerVisionSamples/" 
            });
    }

}